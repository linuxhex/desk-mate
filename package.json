{
  "name": "desk-mate",
  "version": "1.0.0",
  "description": "桌面Excel分析助手",
  "author": "desk-mate",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.desk-mate.app",
    "productName": "桌面Excel分析助手",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist-build",
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "xlsx": "^0.18.0"
  }
}
